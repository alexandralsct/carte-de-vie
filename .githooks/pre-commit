#!/usr/bin/env bash
# Hook local : le garde-fou passe avant chaque commit. Activer une fois : git config core.hooksPath .githooks
# Liste des mots privés (jamais ici) : variable MOTS_FICHIER, ou « git config gardefou.motsfichier <chemin> » (réglage local de ce clone).
export MOTS_FICHIER="${MOTS_FICHIER:-$(git config --get gardefou.motsfichier || true)}"
exec bash "$(git rev-parse --show-toplevel)/tests/garde-fou.sh"
