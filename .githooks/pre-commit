#!/usr/bin/env bash
# Hook local : le garde-fou passe avant chaque commit. Activer une fois : git config core.hooksPath .githooks
# La liste des mots privés est lue dans le dépôt privé de données (jamais ici) : MOTS_FICHIER, sinon l'emplacement habituel.
export MOTS_FICHIER="${MOTS_FICHIER:-$(git rev-parse --show-toplevel)/../carte-de-vie-donnees/securite/mots-sensibles.txt}"
exec bash "$(git rev-parse --show-toplevel)/tests/garde-fou.sh"
